! ELEGANT analogue of examples/006_touschek/000_touschek_toy_ring.py.
! The TSCATTER markers are at each magnet entrance and at the ring end.

TS0: TSCATTER
TS1: TSCATTER
TS2: TSCATTER
TS3: TSCATTER
TS4: TSCATTER
TS5: TSCATTER
TS6: TSCATTER
TS7: TSCATTER
TS8: TSCATTER

QF1: QUAD, L=0.3, K1=0.1
QD1: QUAD, L=0.3, K1=-0.7
QF2: QUAD, L=0.3, K1=0.1
QD2: QUAD, L=0.3, K1=-0.7

! E1=E2=0 matches xtrack's edge=None configuration.
B1: SBEN, L=3.0, ANGLE=1.5707963267948966, E1=0, E2=0
B2: SBEN, L=3.0, ANGLE=1.5707963267948966, E1=0, E2=0
B3: SBEN, L=3.0, ANGLE=1.5707963267948966, E1=0, E2=0
B4: SBEN, L=3.0, ANGLE=1.5707963267948966, E1=0, E2=0

D11: DRIF, L=1.0
D21: DRIF, L=1.0
D31: DRIF, L=1.0
D41: DRIF, L=1.0
D12: DRIF, L=1.0
D22: DRIF, L=1.0
D32: DRIF, L=1.0
D42: DRIF, L=1.0

RING: LINE=(TS0,QF1,D11,TS1,B1,D21,TS2,QD1,D31,TS3,B2,D41, &
            TS4,QF2,D12,TS5,B3,D22,TS6,QD2,D32,TS7,B4,D42,TS8)
